# Contact form email (Google Workspace SMTP)
# SMTP_USER: the Google Workspace mailbox that sends the form emails
# SMTP_PASS: a Google App Password for that mailbox (not the normal password)
SMTP_USER=
SMTP_PASS=
# Optional overrides (defaults: smtp.gmail.com / 465)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
